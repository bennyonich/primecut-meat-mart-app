// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum MeatShareAnimal {
  COW
  RAM
  GOAT
}

/// Cow: buy 1–N slots of a full animal. Ram/Goat: half or quarter portions.
enum MeatShareKind {
  COW_SLOT
  HALF
  QUARTER
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  reviews       Review[]
  messages      ChatMessage[]
  subscriptions Subscription[]
  accounts      Account[]
  sessions      Session[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String      @id @default(cuid())
  name             String
  description      String
  priceNgnKobo     Int
  imageUrl         String?
  categoryId       String
  inventoryInStock Int         @default(0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  category         Category    @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  reviews          Review[]
}

model Order {
  id                 String              @id @default(cuid())
  userId             String
  status             OrderStatus         @default(PENDING)
  totalAmountNgnKobo Int
  deliveryAddress    String
  deliverySlot       String
  paystackReference  String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  meatShareItems     OrderMeatShareItem[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  quantity         Int
  unitPriceNgnKobo Int
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id])
}

/// Group buy: e.g. full cow split into 10 slots, or ram/goat half & quarter.
model MeatShareOffering {
  id                 String          @id @default(cuid())
  title              String
  description        String
  imageUrl           String?
  animal             MeatShareAnimal
  kind               MeatShareKind
  /// Cow only: total slots (e.g. 10). Null for ram/goat portions.
  totalSlots         Int?
  /// Cow: slots still available. Ignored for HALF/QUARTER (use stockRemaining).
  slotsRemaining     Int?
  /// Ram/Goat half/quarter: units in stock.
  stockRemaining     Int             @default(0)
  /// Price per slot (cow) or fixed price for half or quarter (kobo).
  priceNgnKobo       Int
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  orderLines         OrderMeatShareItem[]

  @@unique([animal, kind])
}

model OrderMeatShareItem {
  id                    String             @id @default(cuid())
  orderId               String
  meatShareOfferingId   String
  /// Slots purchased (cow) or 1 for half/quarter.
  quantity              Int
  unitPriceNgnKobo      Int
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  meatShareOffering     MeatShareOffering  @relation(fields: [meatShareOfferingId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                  String   @id @default(cuid())
  userId              String
  title               String
  cadence             String
  nextDeliveryDate    DateTime
  isActive            Boolean  @default(true)
  amountNgnKobo       Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  message     String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
